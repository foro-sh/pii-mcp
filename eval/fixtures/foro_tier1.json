{
  "source": "Local ../platform checkout (private). Vendored cases for public CI. Run python eval/sync_foro_tier1.py after editing platform Tier 1 tests.",
  "purpose": "Adoption gate: pii-mcp must match or strictly improve foro-pii Tier 1 masking on these inputs. CI fails on any regression.",
  "default_languages": [
    "en",
    "nl"
  ],
  "cases": [
    {
      "id": "clean-prose",
      "kind": "negative",
      "input": "The server exposes a search tool and a fetch tool.",
      "expect_text": "The server exposes a search tool and a fetch tool.",
      "expect_counts": {
        "email": 0
      }
    },
    {
      "id": "email-plain",
      "kind": "positive",
      "input": "Contact ada@example.com for help",
      "expect_text": "Contact [EMAIL] for help",
      "expect_counts": {
        "email": 1
      }
    },
    {
      "id": "email-plus-subdomain",
      "kind": "positive",
      "input": "to a.b+tag@mail.sub.example.co.uk now",
      "expect_text": "to [EMAIL] now",
      "expect_counts": {
        "email": 1
      }
    },
    {
      "id": "email-multiple",
      "kind": "positive",
      "input": "one@a.com, two@b.org, three@c.net",
      "expect_text": "[EMAIL], [EMAIL], [EMAIL]",
      "expect_counts": {
        "email": 3
      }
    },
    {
      "id": "email-bare-handle",
      "kind": "negative",
      "input": "ping @octocat about this",
      "expect_text": "ping @octocat about this",
      "expect_counts": {
        "email": 0
      }
    },
    {
      "id": "iban-compact-nl",
